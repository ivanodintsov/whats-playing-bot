<html>
  <head>
    {{> base-meta}}
    <meta charset="utf-8" />
    <title>Error</title>
    <style>
      @import url("https://fonts.googleapis.com/css?family=Lato");

      * {
        position: relative;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Lato", sans-serif;
        font-size: 18px;
      }

      .centered {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2rem 30px;
      }

      .container {
        margin: auto 0;
      }

      h1 {
        margin-bottom: 1rem;
        font-size: 36px;
      }

      h1,
      .status {
        font-family: "Lato", sans-serif;
      }

      .status {
        font-size: 24px;
        margin-bottom: 0;
        margin-top: 2rem;
        font-weight: 600;
      }

      .message {
        font-size: 20px;
      }
    </style>
  </head>
  <body>
    <section class="centered">
      <div class="container">
        <h1>{{exceptionError}}</h1>
        <p class="message">{{exceptionMessage}}</p>
      </div>
      <p class="status">{{status}} Error</p>
    </section>
  </body>
</html>