<script src="{{{assets "/js/ua-parser.min.js"}}}"></script>
{{#if song.appLink}}
  <script>
    var parser = new UAParser();
    var parserResults = parser.getResult();
    var osName = parserResults && parserResults.os && parserResults.os.name;
    var link = null;
    var iosLink = '{{{ song.appLink.ios }}}';
    var androidLink = '{{{ song.appLink.android }}}';
    var desktopLink = '{{{ song.appLink.desktop }}}';

    if (osName) {
      if (osName === 'iOS' && iosLink) {
        link = iosLink;
      } else if ((osName === 'Android' || osName === 'Android-x86') && androidLink) {
        link = androidLink;
      } else if (desktopLink) {
        link = desktopLink;
      }
    }

    if (link) {
      setTimeout(function() {
        window.location = link;
      }, 400);
    }
  </script>
{{else}}
  <script>
    setTimeout(function () {
      try {
        window.open('{{{ song.link }}}', '_blank').focus();
      } catch (e) {
        console.log(e)
      }
    }, 400);
  </script>
{{/if}}