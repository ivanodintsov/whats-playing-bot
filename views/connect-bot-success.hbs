{{#section 'head'}}
  <style>
    .root {
      text-align: center;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      right: 0;
      justify-content: center;
    }

    .container {
      padding: 40px;
    }

    .container h1 {
      margin: 0;
    }
    
    .grid {
      display: grid;
      row-gap: 35px;
    }

    .buttons {
      display: flex;
      justify-content: center;
    }

    .grid-ad {
      display: flex;
      justify-content: center;
      flex-direction: column;
      align-items: center;
    }

    .grid-ad div {
      max-width: 432px;
      width: 100%;
    }
  </style>
  {{> gtm}}
{{/section}}

<div class='root'>
  <div class='container'>
    <div class='grid'>
      <div class='grid-ad'>
        <div>
          {{{ad2}}}
      </div>
      <h1>Spotify Connected</h1>
      <div class='buttons'>
        <a href='{{{ openUrl }}}' class='button button-{{{ platform }}}'>
          Open {{{ platform }}}
          <span class='button-bg'></span>
        </a>
      </div>
      <div>
        {{> logo}}
      </div>
    </div>
  </div>
</div>

